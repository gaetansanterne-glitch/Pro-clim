
/* ==========================================
   PRO CLIM — BUDGET ET TEMPS DE CHANTIER
========================================== */

document.addEventListener("DOMContentLoaded", () => {
    const commentaires = document.getElementById("commentaires");
    if (!commentaires) return;

    function euros(valeur) {
        return valeur.toLocaleString("fr-FR", {
            style: "currency",
            currency: "EUR",
            maximumFractionDigits: 0
        });
    }

    function valeur(id) {
        const champ = document.getElementById(id);
        return Math.max(0, Number(champ?.value || 0));
    }

    function calculer() {
        const jours = Math.max(0.5, valeur("pcJours"));
        const equipe = Math.max(1, Math.floor(valeur("pcEquipe")));
        const heures = Math.min(24, Math.max(1, valeur("pcHeures")));
        const taux = valeur("pcTaux");
        const materiel = valeur("pcMateriel");
        const marge = valeur("pcMarge") / 100;
        const tva = valeur("pcTVA") / 100;
        const budget = valeur("pcBudget");

        const temps = jours * equipe * heures;
        const mainOeuvre = temps * taux;
        const prixHT = (materiel + mainOeuvre) * (1 + marge);
        const prixTTC = prixHT * (1 + tva);

        document.getElementById("pcTemps").textContent =
            `${temps.toLocaleString("fr-FR")} h`;

        document.getElementById("pcMO").textContent =
            euros(mainOeuvre);

        document.getElementById("pcHT").textContent =
            euros(prixHT);

        document.getElementById("pcTTC").textContent =
            euros(prixTTC);

        const jauge = document.getElementById("pcJauge");
        const statut = document.getElementById("pcStatut");
        const pourcentage = document.getElementById("pcPourcentage");

        if (!budget) {
            jauge.style.width = "0%";
            pourcentage.textContent = "Budget à renseigner";
            statut.textContent = "Saisis le budget total du client.";
            statut.style.color = "";
            return;
        }

        const ratio = prixTTC / budget;
        jauge.style.width = `${Math.min(100, ratio * 100)}%`;
        jauge.style.background =
            ratio <= 0.85 ? "#22a447" :
            ratio <= 1 ? "#e9a23b" : "#d93636";

        pourcentage.textContent = `${Math.round(ratio * 100)} %`;

        if (ratio <= 0.85) {
            statut.textContent =
                `Budget respecté. Reste ${euros(budget - prixTTC)}.`;
            statut.style.color = "#16803c";
        } else if (ratio <= 1) {
            statut.textContent =
                `Budget presque atteint. Reste ${euros(budget - prixTTC)}.`;
            statut.style.color = "#a16207";
        } else {
            statut.textContent =
                `Budget dépassé de ${euros(prixTTC - budget)}.`;
            statut.style.color = "#c62828";
        }
    }

    function afficher() {
        const contenu = commentaires.innerText || "";

        if (!contenu.includes("Détail de l'étude") &&
            !contenu.includes("Synthèse multi-split")) {
            document.getElementById("pcBudgetBloc")?.remove();
            return;
        }

        if (document.getElementById("pcBudgetBloc")) return;

        const bloc = document.createElement("section");
        bloc.id = "pcBudgetBloc";

        bloc.style.cssText =
            "margin-top:18px;padding:16px;border:1px solid #ccc;border-radius:14px;";

        bloc.innerHTML = `
            <h3>💶 Budget et temps de chantier</h3>
            <p>Toutes les valeurs sont modifiables.</p>

            <label>Budget total client (€ TTC)
                <input id="pcBudget" type="number" min="0" placeholder="Ex. 5000">
            </label><br>

            <label>Durée prévue (jours)
                <input id="pcJours" type="number" min="0.5" step="0.5" value="2">
            </label><br>

            <label>Nombre de techniciens
                <input id="pcEquipe" type="number" min="1" step="1" value="1">
            </label><br>

            <label>Heures par jour et par technicien
                <input id="pcHeures" type="number" min="1" max="24" value="7">
            </label><br>

            <label>Coût horaire chargé (€ / h)
                <input id="pcTaux" type="number" min="0" value="50">
            </label><br>

            <label>Coût matériel HT (€)
                <input id="pcMateriel" type="number" min="0" value="2200">
            </label><br>

            <label>Marge commerciale (%)
                <input id="pcMarge" type="number" min="0" value="25">
            </label><br>

            <label>TVA (%)
                <input id="pcTVA" type="number" min="0" max="100" value="20">
            </label>

            <hr>
            <p>Temps total équipe : <strong id="pcTemps">14 h</strong></p>
            <p>Coût de main-d'œuvre : <strong id="pcMO">700 €</strong></p>
            <p>Prix estimé HT : <strong id="pcHT">3 625 €</strong></p>
            <p>Prix estimé TTC : <strong id="pcTTC">4 350 €</strong></p>

            <p>Budget utilisé : <strong id="pcPourcentage">À calculer</strong></p>
            <div style="height:12px;background:#ddd;border-radius:20px;overflow:hidden">
                <div id="pcJauge" style="height:100%;width:0%;background:#22a447"></div>
            </div>
            <p id="pcStatut">Saisis le budget total du client.</p>

            <small>
                Estimation indicative. Le coût matériel doit être ajusté
                selon les tarifs réels. Vérifie les frais de chantier et la TVA.
            </small>
        `;

        commentaires.appendChild(bloc);

        bloc.querySelectorAll("input").forEach(champ => {
            champ.addEventListener("input", calculer);
        });

        calculer();
    }

    new MutationObserver(afficher).observe(commentaires, {
        childList: true,
        subtree: true,
        characterData: true
    });

    afficher();
});
// Pro Clim - republication du fichier budget
